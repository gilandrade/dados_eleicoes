# Copie para .env (git-ignorado) e preencha com valores de verdade.
# .env nunca é commitado — ver .gitignore.

# CARTO Basemaps agora exige API key mesmo para o preset "CartoDB positron"
# do folium (confirmado em 29/09/2026). Usada só para os tiles de fundo dos
# mapas (etapa 05, src/eleicoes/mapas.py) — não é segredo de servidor, fica
# visível no HTML publicado de qualquer jeito, mas não deve ficar hardcoded
# no código-fonte.
CARTO_API_KEY=

# osmium-tool, usado em 03c_recorta_osm.qmd para recortar o OSM por município.
# Instalação: micromamba create -n osm -c conda-forge osmium-tool; aponte para o osmium.exe.
OSMIUM_BIN=
